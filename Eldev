; -*- mode: emacs-lisp; lexical-binding: t -*-

(eldev-use-package-archive 'gnu-elpa)
(eldev-use-package-archive 'nongnu-elpa)

;; Test files require `revu-fixture', which lives beside them.  The `emacs'
; command gets the same root, so that a scratch script run through
; `eldev emacs' can build the fixture repository and open a Review in it.
(eldev-add-loading-roots '(test emacs) "test")

;; The magit Bridge (ADR-0013) is compile-checked only: magit is here so
;; that `revu-magit.el' byte-compiles and lints against the real names,
;; and deliberately not a test dependency -- the mapping the tests cover
;; is pure and runs with magit absent.
(eldev-add-extra-dependencies 'build '(:package magit :version "4.4"))
(eldev-add-extra-dependencies 'lint '(:package magit :version "4.4"))
